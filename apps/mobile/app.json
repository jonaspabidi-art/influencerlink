{
  "expo": {
    "name": "InfluencerLink",
    "slug": "influencerlink",
    "scheme": "influencerlink",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "locales": {
      "sv": "./locales/sv.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "se.influencerlink.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "LSApplicationQueriesSchemes": [
          "bankid"
        ]
      }
    },
    "android": {
      "package": "se.influencerlink.app",
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "influencerlink"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E8543F"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": ""
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "InfluencerLink",
      "shortName": "InfluencerLink",
      "description": "Restauranger och kreatörer hittar varandra, med avtal och spärrad betalning.",
      "display": "standalone",
      "themeColor": "#E8543F",
      "backgroundColor": "#F7F2EA",
      "lang": "sv"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F2EA"
    },
    "backgroundColor": "#F7F2EA",
    "primaryColor": "#E8543F"
  }
}
