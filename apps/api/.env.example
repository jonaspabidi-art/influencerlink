# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Kommaseparerade origins som får anropa API:et.
CORS_ORIGINS=http://localhost:8081

# --- Databas ---
DATABASE_URL=postgresql://influencerlink:influencerlink@localhost:5432/influencerlink

# --- Krypto ---
# Minst 32 tecken. Signerar JWT-sessioner.
JWT_SECRET=byt-ut-mig-till-minst-32-tecken-langt-varde
# Minst 32 tecken. HMAC-nyckel för personnummeruppslag.
PERSONAL_NUMBER_HMAC_KEY=byt-ut-mig-till-minst-32-tecken-langt-varde
# Exakt 32 byte i base64. Krypterar OAuth-tokens för sociala konton.
TOKEN_ENCRYPTION_KEY=

# --- BankID ---
# mock = inbyggd simulator, live = riktig BankID-miljö via mTLS.
BANKID_MODE=mock
BANKID_API_URL=https://appapi2.test.bankid.com/rp/v6.0
# Sökväg till RP-certifikat (PKCS#12 eller PEM) och BankID:s CA.
BANKID_CLIENT_CERT_PATH=
BANKID_CLIENT_KEY_PATH=
BANKID_CA_PATH=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Dit Stripe skickar användaren efter Connect-onboarding.
STRIPE_CONNECT_RETURN_URL=influencerlink://stripe/return
STRIPE_CONNECT_REFRESH_URL=influencerlink://stripe/refresh

# --- Claude (matchning och kampanjutkast) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
